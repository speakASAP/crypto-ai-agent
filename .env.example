# Crypto AI Agent Environment Variables
ENVIRONMENT=production
DEBUG=false
COMPOSE_PROJECT_NAME=crypto-ai-agent

# News API Configuration
NEWS_API_KEY=your-news-api-key-here

# JWT Configuration for user authentication
JWT_SECRET=your-jwt-secret-here
NEXT_PUBLIC_WS_URL=ws://localhost:8100/

# Agent Configuration
WINDOW=50
PREDICTION_CACHE_TIME=10
MAX_PRICE_HISTORY=200

# Database Configuration
DATABASE_FILE=data/crypto_portfolio.db

# UI Configuration
UI_PORT=8501
UI_HOST=0.0.0.0

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/crypto_agent.log
LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"

# Default Symbols Configuration
SYMBOLS=

# API URLs Configuration
CURRENCY_API_URL=https://api.exchangerate-api.com/v4/latest/USD
BINANCE_API_URL=https://api.binance.com/api/v3/ticker/price
CRYPTOPANIC_API_URL=https://cryptopanic.com/api/v1/posts/

# News Sources Configuration
NEWS_SOURCES=https://www.coindesk.com/arc/outboundfeeds/rss/?outputType=xml,https://cointelegraph.com/rss,https://bitcoinmagazine.com/rss,https://cryptoslate.com/feed/,https://decrypt.co/feed

# Currency Fallback Rates
CURRENCY_FALLBACK_EUR=
CURRENCY_FALLBACK_CZK=

# Cache Configuration
CURRENCY_CACHE_DURATION=1800

# Additional configuration variables
HTTP_TIMEOUT=10

# API Configuration  
API_HOST=0.0.0.0
API_PORT=8100
CORS_ORIGINS=http://localhost:3100,https://yourdomain.com

# External API URLs
TELEGRAM_API_URL=https://api.telegram.org/bot

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8100
NEXT_PUBLIC_WS_URL=ws://localhost:8100/
FRONTEND_REFRESH_INTERVAL=30000
NEXT_PUBLIC_FRONTEND_REFRESH_INTERVAL=30000

# Script Configuration
BACKEND_PORT=8100
FRONTEND_PORT=3100
LOG_DIR=logs
DATA_DIR=data
DATABASE_URL=
SECRET_KEY=

# Blue/Green Deployment Configuration
DEPLOYMENT_COLOR=blue
COMPOSE_PROJECT_NAME_BLUE=crypto_ai_agent_blue
COMPOSE_PROJECT_NAME_GREEN=crypto_ai_agent_green

# Blue/Green Deployment Port Configuration
POSTGRES_PORT_GREEN=5433
REDIS_PORT_GREEN=6380
REDIS_APPENDONLY=no
API_PORT_GREEN=8101
FRONTEND_PORT_GREEN=3101
